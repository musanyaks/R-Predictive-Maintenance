# File: .gitignore
# R
.Rhistory
.RData
.Rproj.user
*.Rproj

# Secrets
.Renviron
.env

# renv (keep renv.lock, ignore infrastructure)
renv/library/
renv/local/

# Data artifacts (generated)
data/raw/*.csv
data/processed/*
!data/processed/.gitkeep

# Model artifacts (generated)
models/classification/**/model.rds
models/regression/**/model.rds
models/anomaly/**/model.rds
models/model_metadata/model_registry.csv

# Logs
logs/**/*
!logs/**/.gitkeep

# Reports output
reports/figures/*
reports/model_performance/*
reports/maintenance_reports/*
!reports/**/.gitkeep

# targets
_targets/meta/
_targets/objects/
_targets/user/

# OS / editors
.DS_Store
*.swp